<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Related Opportunities</masterLabel>
    <description>Upsell Opportunities linked to this Case or CSM Call, with a New Opportunity button that adds products in one step.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Case</object>
                <object>CSM_Call__c</object>
            </objects>
            <property name="pricebookName" type="String" label="Price Book" default="Service"
                description="Name of the active price book used for new Opportunities and their products."/>
            <supportedFormFactors>
                <supportedFormFactor type="Small"/>
                <supportedFormFactor type="Large"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>