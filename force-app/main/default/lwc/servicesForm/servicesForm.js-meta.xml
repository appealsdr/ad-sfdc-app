<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
	<apiVersion>61.0</apiVersion>
	<isExposed>true</isExposed>
	<masterLabel>Services form</masterLabel>
	<targets>
		<target>lightning__AppPage</target>
		<target>lightning__HomePage</target>
		<target>lightning__RecordPage</target>
		<target>lightning__Tab</target>
	</targets>
	<targetConfigs>
		<targetConfig targets="lightning__AppPage">
			<supportedFormFactors>
				<supportedFormFactor type="Small"/>
				<supportedFormFactor type="Large"/>
			</supportedFormFactors>
		</targetConfig>
		<targetConfig targets="lightning__HomePage">
			<supportedFormFactors>
				<supportedFormFactor type="Large"/>
			</supportedFormFactors>
		</targetConfig>
		<targetConfig targets="lightning__RecordPage">
			<supportedFormFactors>
				<supportedFormFactor type="Small"/>
				<supportedFormFactor type="Large"/>
			</supportedFormFactors>
			<property name="serviceActionFor" type="String" label="Service Action For" default="create"
                description="Purpose of this component (e.g. update, create)" />
			<property name="currentStep" type="String" label="Current Step" default="2"
                description="open the screen accordingly (e.g. 1,2, 3)" />
           
		</targetConfig>
	</targetConfigs>
</LightningComponentBundle>