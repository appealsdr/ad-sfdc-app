<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Cancellation_Date</name>
        <label>Align Cancellation Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Cancellation_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Aligned_Date</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <formulas>
        <name>Aligned_Date</name>
        <dataType>Date</dataType>
        <expression>IF(OR(ISPICKVAL({!$Record.Status__c}, &quot;Closed&quot;), ISPICKVAL({!$Record.Status__c}, &quot;Inactive&quot;)), BLANKVALUE({!$Record.Cancellation_Date__c}, {!$Flow.CurrentDate}), IF(ISPICKVAL({!$Record.Status__c}, &quot;Active&quot;), NULL, {!$Record.Cancellation_Date__c}))</expression>
    </formulas>
    <interviewLabel>CSM Cancellation Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CSM Account Cancellation Date</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Cancellation_Date</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Status__c}), ISCHANGED({!$Record.Cancellation_Date__c}))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
