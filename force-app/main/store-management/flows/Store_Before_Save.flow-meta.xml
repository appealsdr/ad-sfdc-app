    </formulas>
    <formulas>
        <name>storeOppAccountId_f</name>
        <dataType>String</dataType>
        <expression>if ( ISBLANK({!$Record.Opportunity__r.AccountId})
, {!$Record.Account__c}
, {!$Record.Opportunity__r.AccountId}
)</expression>
    </formulas>
    <formulas>
        <name>whiteGloveCheckbox</name>
        <dataType>Boolean</dataType>
        <expression>IF (
 ISCHANGED({!$Record.RecordTypeId}) &amp;&amp; {!$Record.RecordType.Name}  &lt;&gt; &apos;White Glove&apos;
,  false
, {!$Record.White_Glove__c}
 )</expression>
    </formulas>
